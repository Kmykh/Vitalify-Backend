# Cadenas de conexión (Supabase, Session pooler, puerto 5432, IPv4).
# Se aceptan dos formatos: clave=valor de Npgsql o URI postgresql://usuario:contraseña@host:puerto/base
# Si el valor contiene # o espacios, ponlo entre comillas dobles. Instrucciones completas en README.md.
ConnectionStrings__Transaccional=Host=<host del pooler>;Port=5432;Database=postgres;Username=postgres.<ref-del-proyecto>;Password=<contraseña>;SSL Mode=Require;Maximum Pool Size=5
# Por ahora la misma cadena; en la fase 7 apuntará a TimescaleDB.
ConnectionStrings__Historial=Host=<host del pooler>;Port=5432;Database=postgres;Username=postgres.<ref-del-proyecto>;Password=<contraseña>;SSL Mode=Require;Maximum Pool Size=5

# JWT (fase 1). Jwt__Clave: mínimo 32 caracteres aleatorios. Genérala con:  openssl rand -base64 48
Jwt__Emisor=vitalify-api
Jwt__Audiencia=vitalify-clientes
Jwt__Clave=
Jwt__MinutosAccessToken=15
Jwt__MinutosInactividad=30
Jwt__HorasMaximasSesion=12

# Primer administrador: se crea al arrancar si no existe ninguno. Si faltan, no se crea nada.
# La contraseña debe tener al menos 8 caracteres, con al menos una letra y un número.
Seed__AdminCorreo=
Seed__AdminNombre=
Seed__AdminContrasena=

# Solo en Development: true crea el servicio MEDICINA-B, las camas MED-B-01 a MED-B-06 y los sensores ESP32-001 a ESP32-004 que falten.
Seed__DatosDemo=false

# Simulador de telemetría (fase 3). Apagado por defecto; intervalo mínimo 5 s.
Simulador__Habilitado=false
Simulador__IntervaloSegundos=10
Simulador__Semilla=12345
# Escenario por dispositivo: Estable (por defecto), Deterioro, Caida, SensorDefectuoso o DeterioroRapido
# (NEWS2 >= 7 en 5 min, para probar alertas y escalamiento).
# Simulador__Escenarios__ESP32-001=Estable

# Broker MQTT del proyecto IoT (IOT/tesis_V01/broker). La clave es MQTT_BACKEND_CLAVE de broker/.env.
Mqtt__Habilitado=false
Mqtt__Servidor=localhost
Mqtt__Puerto=1883
Mqtt__Usuario=vitalify-backend
Mqtt__Clave=

# Vinculación por QR: vigencia del QR y del token (minutos), códigos equivocados antes de invalidar el QR y
# cada cuántos segundos se renuevan los QR vencidos de los sensores en línea (0 apaga la renovación).
# Vinculacion__MinutosVigenciaCodigo=10
# Vinculacion__MinutosVigenciaToken=5
# Vinculacion__IntentosMaximos=5
# Vinculacion__SegundosRenovacion=60

# Motor clínico: minutos de tolerancia tras la próxima toma manual (un valor manual cuenta hasta su próxima toma
# más esta tolerancia, con un tope de 12 h) y desfase en °C de la temperatura de piel del sensor.
# Clinico__MinutosToleranciaToma=30
# Clinico__AjusteTemperaturaSensor=0

# Turnos de enfermería (fase 6): zona horaria de la planilla y horario de cada tipo de turno (HH:mm).
# Turnos__ZonaHoraria=America/Lima
# Turnos__Tipos__GuardiaDiurna__Inicio=07:00
# Turnos__Tipos__GuardiaDiurna__Fin=19:00
# Turnos__Tipos__GuardiaNocturna__Inicio=19:00
# Turnos__Tipos__GuardiaNocturna__Fin=07:00
# Turnos__Tipos__Manana__Inicio=07:00
# Turnos__Tipos__Manana__Fin=13:00
# Turnos__Tipos__Tarde__Inicio=13:00
# Turnos__Tipos__Tarde__Fin=19:00

# Alertas (fase 6): sin señal tras N segundos sin lecturas, escalamiento de las pendientes (minutos) y cada cuántos
# segundos corre el vigilante (0 lo apaga).
# Alertas__SegundosSinSenal=180
# Alertas__Escalamiento__MinutosAlta=5
# Alertas__Escalamiento__MinutosMedia=15
# Alertas__SegundosVigilancia=30
# Tras atender una alerta de riesgo, minutos sin abrir otra del mismo nivel (0 la desactiva).
# Alertas__MinutosEsperaTrasAtender=30

# Push por Firebase Cloud Messaging (fase 6). Apagado, el push solo se escribe en el log.
# La ruta apunta al JSON de la cuenta de servicio, FUERA del repositorio (nunca se sube).
Push__Habilitado=false
# Push__RutaCredencialesFirebase=/ruta/fuera/del/repo/vitalify-firebase-adminsdk.json

# Telemetría: valores por defecto (descomenta para cambiarlos).
# Telemetria__SegundosVigencia=90
# Telemetria__HorasMaximasRetraso=24
# Telemetria__SegundosCacheDispositivo=15
# Telemetria__Rangos__Fc__Minimo=20
# Telemetria__Rangos__Fc__Maximo=250
