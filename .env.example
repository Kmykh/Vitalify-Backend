# Cadenas de conexión (Supabase, Session pooler, puerto 5432, IPv4).
# Se aceptan dos formatos: clave=valor de Npgsql o URI postgresql://usuario:contraseña@host:puerto/base
# Si el valor contiene # o espacios, ponlo entre comillas dobles. Instrucciones completas en README.md.
ConnectionStrings__Transaccional=Host=<host del pooler>;Port=5432;Database=postgres;Username=postgres.<ref-del-proyecto>;Password=<contraseña>;SSL Mode=Require;Maximum Pool Size=5
# Por ahora la misma cadena; en la fase 7 apuntará a TimescaleDB.
ConnectionStrings__Historial=Host=<host del pooler>;Port=5432;Database=postgres;Username=postgres.<ref-del-proyecto>;Password=<contraseña>;SSL Mode=Require;Maximum Pool Size=5

# JWT (fase 1). Jwt__Clave: mínimo 32 caracteres aleatorios. Genérala con:  openssl rand -base64 48
Jwt__Emisor=vitalify-api
Jwt__Audiencia=vitalify-clientes
Jwt__Clave=
Jwt__MinutosAccessToken=15
Jwt__MinutosInactividad=30
Jwt__HorasMaximasSesion=12

# Primer administrador: se crea al arrancar si no existe ninguno. Si faltan, no se crea nada.
# La contraseña debe tener al menos 8 caracteres, con al menos una letra y un número.
Seed__AdminCorreo=
Seed__AdminNombre=
Seed__AdminContrasena=

# Solo en Development: true crea las camas MED-B-01 a MED-B-06 y los sensores ESP32-001 a ESP32-004 que falten.
Seed__DatosDemo=false
